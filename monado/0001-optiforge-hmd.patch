+//! How long fading to white and back takes when head tracking is lost and found again.
+#define WHITE_FADE_DURATION_NS (500 * U_TIME_1MS_IN_NS)
+
 /*
  *
  * Helper macros for adding semaphores to lists.
@@ -128,6 +131,12 @@ struct comp_renderer
 
 	struct comp_mirror_to_debug_gui mirror_to_debug_gui;
 
+	//! How much the output is faded to white, 0 to 1, see @ref update_white_fade.
+	float white_fade;
+
+	//! Display time of the frame the white fade was last updated for.
+	int64_t white_fade_last_ns;
+
 	//! @}
 
 	//! @name Image-dependent members
@@ -317,6 +326,44 @@ calc_scanout_compensation_ns(struct comp_renderer *r)
 	return 0;
 }
 
+//! Is the head orientation not tracked at the time the frame being rendered is displayed?
+static bool
+is_head_tracking_lost(struct comp_renderer *r)
+{
+	struct xrt_space_relation head_relation = XRT_SPACE_RELATION_ZERO;
+	xrt_result_t xret = xrt_device_get_tracked_pose(     //
+	    r->c->xdev,                                      //
+	    XRT_INPUT_GENERIC_HEAD_POSE,                     //
+	    r->c->frame.rendering.predicted_display_time_ns, // at_timestamp_ns
+	    &head_relation);                                 //
+	if (xret != XRT_SUCCESS) {
+		return false;
+	}
+
+	return (head_relation.relation_flags & XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT) == 0;
+}
+
+//! Step the white fade towards white while the head isn't tracked and back otherwise, returns the new fade.
+static float
+update_white_fade(struct comp_renderer *r)
+{
+	int64_t now_ns = r->c->frame.rendering.predicted_display_time_ns;
+	int64_t delta_ns = r->white_fade_last_ns != 0 ? now_ns - r->white_fade_last_ns : 0;
+	r->white_fade_last_ns = now_ns;
+
+	// Ignore time going backwards, and don't jump over the whole fade after a stall.
+	delta_ns = CLAMP(delta_ns, 0, WHITE_FADE_DURATION_NS / 10);
+	float step = (float)delta_ns / (float)WHITE_FADE_DURATION_NS;
+
+	if (is_head_tracking_lost(r)) {
+		r->white_fade = MIN(r->white_fade + step, 1.0f);
+	} else {
+		r->white_fade = MAX(r->white_fade - step, 0.0f);
+	}
+
+	return r->white_fade;
+}
+
 static void
 calc_pose_data(struct comp_renderer *r,
                enum comp_target_fov_source fov_source,
@@ -1144,6 +1191,9 @@ comp_renderer_draw(struct comp_renderer *r)
 	    fast_path,        //
 	    &c->scratch);     //
 
+	// A frozen head pose makes people sick, fade to white instead, like SteamVR.
+	frame_state.data.white_fade = update_white_fade(r);
+
