diff --git a/src/xrt/drivers/optiforge/optiforge_hmd.c b/src/xrt/drivers/optiforge/optiforge_hmd.c
new file mode 100644
index 000000000..b776bb73a
--- /dev/null
+++ b/src/xrt/drivers/optiforge/optiforge_hmd.c
@@ -0,0 +1,465 @@
+// Copyright 2026, Optiforge.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Optiforge HMD: Waveshare 1080x1920 portrait panel, head pose from a Vive tracker mounted on the headset.
+ *
+ * Based on the sample HMD driver. Configured with environment variables:
+ *
+ * - OPTIFORGE_HMD=1                  enable (checked by the lighthouse builder)
+ * - OPTIFORGE_TRACKER_SERIAL         tracker serial (e.g. LHR-8BD7C17A), empty = first generic tracker
+ * - OPTIFORGE_TRACKER_YAW/PITCH/ROLL head rotation relative to the tracker, degrees (Y, X, Z axes, applied in that
+ *                                    order, same as trackerYaw/Pitch/Roll in the SteamVR driver)
+ * - OPTIFORGE_FORWARD_CORRECTION     sensor distance in front of the eyes, centimetres
+ * - OPTIFORGE_CENTER_CORRECTION      sensor distance to the wearer's right of the centre between the eyes, centimetres
+ * - OPTIFORGE_HEIGHT_CORRECTION      sensor distance above the eyes, centimetres
+ * - OPTIFORGE_INVERT_YAW/PITCH/ROLL=1 invert that axis of the head rotation (like "invert mouse" in games)
+ * - OPTIFORGE_PANEL_ROTATION         none (left/right halves of the panel), left or right (top/bottom halves,
+ *                                    rotated 90 degrees)
+ * - OPTIFORGE_SWAP_EYES=1            swap which half of the panel is the left eye
+ * - OPTIFORGE_FOV                    horizontal field of view per eye, degrees (vertical follows the aspect ratio)
+ * - OPTIFORGE_REFRESH_HZ             panel refresh rate
+ *
+ * @ingroup drv_optiforge
+ */
+
+#include "xrt/xrt_defines.h"
+#include "xrt/xrt_device.h"
+#include "xrt/xrt_results.h"
+
+#include "math/m_api.h"
+#include "math/m_mathinclude.h" // IWYU pragma: keep
+#include "math/m_vec3.h"
+
+#include "util/u_debug.h"
+#include "util/u_device.h"
+#include "util/u_distortion_mesh.h"
+#include "util/u_logging.h"
+#include "util/u_misc.h"
+#include "util/u_time.h"
+#include "util/u_var.h"
+#include "util/u_visibility_mask.h"
+
+#include "optiforge_interface.h"
+
+#include <stdio.h>
+#include <string.h>
+
+
+/*
+ *
+ * Structs and defines.
+ *
+ */
+
+#define PANEL_W_PIXELS 1080
+#define PANEL_H_PIXELS 1920
+
+DEBUG_GET_ONCE_LOG_OPTION(optiforge_log, "OPTIFORGE_LOG", U_LOGGING_INFO)
+DEBUG_GET_ONCE_BOOL_OPTION(optiforge_hmd, "OPTIFORGE_HMD", false)
+DEBUG_GET_ONCE_OPTION(optiforge_tracker_serial, "OPTIFORGE_TRACKER_SERIAL", NULL)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_yaw, "OPTIFORGE_TRACKER_YAW", 0.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_pitch, "OPTIFORGE_TRACKER_PITCH", 0.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_roll, "OPTIFORGE_TRACKER_ROLL", 0.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_forward_correction, "OPTIFORGE_FORWARD_CORRECTION", 0.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_center_correction, "OPTIFORGE_CENTER_CORRECTION", 0.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_height_correction, "OPTIFORGE_HEIGHT_CORRECTION", 0.0f)
+DEBUG_GET_ONCE_BOOL_OPTION(optiforge_invert_yaw, "OPTIFORGE_INVERT_YAW", false)
+DEBUG_GET_ONCE_BOOL_OPTION(optiforge_invert_pitch, "OPTIFORGE_INVERT_PITCH", false)
+DEBUG_GET_ONCE_BOOL_OPTION(optiforge_invert_roll, "OPTIFORGE_INVERT_ROLL", false)
+DEBUG_GET_ONCE_OPTION(optiforge_panel_rotation, "OPTIFORGE_PANEL_ROTATION", "none")
+DEBUG_GET_ONCE_BOOL_OPTION(optiforge_swap_eyes, "OPTIFORGE_SWAP_EYES", false)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_fov, "OPTIFORGE_FOV", 90.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(optiforge_refresh_hz, "OPTIFORGE_REFRESH_HZ", 60.0f)
+
+#define OF_DEBUG(hmd, ...) U_LOG_XDEV_IFL_D(&hmd->base, hmd->log_level, __VA_ARGS__)
+#define OF_INFO(hmd, ...) U_LOG_XDEV_IFL_I(&hmd->base, hmd->log_level, __VA_ARGS__)
+#define OF_WARN(hmd, ...) U_LOG_XDEV_IFL_W(&hmd->base, hmd->log_level, __VA_ARGS__)
+#define OF_ERROR(hmd, ...) U_LOG_XDEV_IFL_E(&hmd->base, hmd->log_level, __VA_ARGS__)
+
+enum optiforge_panel_rotation
+{
+	PANEL_ROTATION_NONE,
+	PANEL_ROTATION_LEFT,
+	PANEL_ROTATION_RIGHT,
+};
+
+/*!
+ * The Optiforge HMD.
+ *
+ * @implements xrt_device
+ */
+struct optiforge_hmd
+{
+	struct xrt_device base;
+
+	//! Vive tracker mounted on the headset, not owned by us.
+	struct xrt_device *tracker;
+
+	//! Head rotation relative to the tracker, degrees. Editable in the debug GUI.
+	float yaw_deg, pitch_deg, roll_deg;
+
+	//! Sensor position relative to the centre between the eyes, in the head's axes, centimetres: forward, to the
+	//! wearer's right, up. Editable in the debug GUI.
+	float forward_cm, center_cm, height_cm;
+
+	//! Invert these axes of the head rotation. Editable in the debug GUI.
+	bool invert_yaw, invert_pitch, invert_roll;
+
+	enum u_logging_level log_level;
+};
+
+
+/// Casting helper function
+static inline struct optiforge_hmd *
+optiforge_hmd(struct xrt_device *xdev)
+{
+	return (struct optiforge_hmd *)xdev;
+}
+
+//! yaw * pitch * roll (Y, X, Z axes), same order as the SteamVR driver. Radians.
+static void
+quat_from_yaw_pitch_roll(float yaw_rad, float pitch_rad, float roll_rad, struct xrt_quat *out_quat)
+{
+	const struct xrt_vec3 y_axis = {0.0f, 1.0f, 0.0f};
+	const struct xrt_vec3 x_axis = {1.0f, 0.0f, 0.0f};
+	const struct xrt_vec3 z_axis = {0.0f, 0.0f, 1.0f};
+
+	struct xrt_quat yaw, pitch, roll, yaw_pitch;
+	math_quat_from_angle_vector(yaw_rad, &y_axis, &yaw);
+	math_quat_from_angle_vector(pitch_rad, &x_axis, &pitch);
+	math_quat_from_angle_vector(roll_rad, &z_axis, &roll);
+
+	math_quat_rotate(&yaw, &pitch, &yaw_pitch);
+	math_quat_rotate(&yaw_pitch, &roll, out_quat);
+}
+
+static void
+get_offset_rotation(struct optiforge_hmd *hmd, struct xrt_quat *out_quat)
+{
+	quat_from_yaw_pitch_roll(                   //
+	    hmd->yaw_deg * (float)(M_PI / 180.0),   //
+	    hmd->pitch_deg * (float)(M_PI / 180.0), //
+	    hmd->roll_deg * (float)(M_PI / 180.0),  //
+	    out_quat);                              //
+}
+
+/*!
+ * Invert the selected axes of the head rotation: split it into world yaw, pitch and roll (inverse of
+ * quat_from_yaw_pitch_roll), negate the selected angles and put it back together.
+ */
+static void
+invert_axes(struct optiforge_hmd *hmd, struct xrt_quat *q)
+{
+	if (!hmd->invert_yaw && !hmd->invert_pitch && !hmd->invert_roll) {
+		return;
+	}
+
+	float w = q->w, x = q->x, y = q->y, z = q->z;
+
+	float sin_pitch = -2.0f * (y * z - w * x);
+	sin_pitch = sin_pitch > 1.0f ? 1.0f : (sin_pitch < -1.0f ? -1.0f : sin_pitch);
+
+	float pitch = asinf(sin_pitch);
+	float yaw = atan2f(2.0f * (x * z + w * y), 1.0f - 2.0f * (x * x + y * y));
+	float roll = atan2f(2.0f * (x * y + w * z), 1.0f - 2.0f * (x * x + z * z));
+
+	quat_from_yaw_pitch_roll(               //
+	    hmd->invert_yaw ? -yaw : yaw,       //
+	    hmd->invert_pitch ? -pitch : pitch, //
+	    hmd->invert_roll ? -roll : roll,    //
+	    q);                                 //
+}
+
+static struct xrt_device *
+find_tracker(struct xrt_device **xdevs, size_t xdev_count, const char *serial)
+{
+	for (size_t i = 0; i < xdev_count; i++) {
+		struct xrt_device *xdev = xdevs[i];
+		if (xdev == NULL || xdev->device_type != XRT_DEVICE_TYPE_GENERIC_TRACKER) {
+			continue;
+		}
+		if (serial == NULL || serial[0] == '\0' || strncmp(xdev->serial, serial, XRT_DEVICE_NAME_LEN) == 0) {
+			return xdev;
+		}
+	}
+	return NULL;
+}
+
+static enum optiforge_panel_rotation
+get_panel_rotation(void)
+{
+	const char *str = debug_get_option_optiforge_panel_rotation();
+	if (str != NULL && strcmp(str, "left") == 0) {
+		return PANEL_ROTATION_LEFT;
+	}
+	if (str != NULL && strcmp(str, "right") == 0) {
+		return PANEL_ROTATION_RIGHT;
+	}
+	return PANEL_ROTATION_NONE;
+}
+
+static void
+setup_views(struct optiforge_hmd *hmd, enum optiforge_panel_rotation rotation, bool swap_eyes)
+{
+	struct xrt_hmd_parts *parts = hmd->base.hmd;
+
+	// The panel as the OS sees it.
+	parts->screens[0].w_pixels = PANEL_W_PIXELS;
+	parts->screens[0].h_pixels = PANEL_H_PIXELS;
+
+	// Index of the panel half used by each eye: 0 = left/top, 1 = right/bottom.
+	uint32_t half[2] = {0, 1};
+	if (rotation == PANEL_ROTATION_RIGHT) {
+		half[0] = 1;
+		half[1] = 0;
+	}
+	if (swap_eyes) {
+		uint32_t tmp = half[0];
+		half[0] = half[1];
+		half[1] = tmp;
+	}
+
+	for (uint32_t eye = 0; eye < 2; eye++) {
+		struct xrt_view *view = &parts->views[eye];
+
+		if (rotation == PANEL_ROTATION_NONE) {
+			// Left and right halves of the portrait panel, no rotation.
+			view->viewport.x_pixels = half[eye] * (PANEL_W_PIXELS / 2);
+			view->viewport.y_pixels = 0;
+			view->viewport.w_pixels = PANEL_W_PIXELS / 2;
+			view->viewport.h_pixels = PANEL_H_PIXELS;
+			view->display.w_pixels = PANEL_W_PIXELS / 2;
+			view->display.h_pixels = PANEL_H_PIXELS;
+			view->rot = u_device_rotation_ident;
+		} else {
+			// Top and bottom halves, rotated (like the OSVR HDK). Viewport is before rotation, display
+			// after.
+			view->viewport.x_pixels = 0;
+			view->viewport.y_pixels = half[eye] * (PANEL_H_PIXELS / 2);
+			view->viewport.w_pixels = PANEL_W_PIXELS;
+			view->viewport.h_pixels = PANEL_H_PIXELS / 2;
+			view->display.w_pixels = PANEL_H_PIXELS / 2;
+			view->display.h_pixels = PANEL_W_PIXELS;
+			view->rot = rotation == PANEL_ROTATION_LEFT ? u_device_rotation_left : u_device_rotation_right;
+		}
+
+		// Symmetric FOV, vertical from the aspect ratio so pixels stay square.
+		double h_fov = debug_get_float_option_optiforge_fov() * (M_PI / 180.0);
+		double aspect = (double)view->display.h_pixels / (double)view->display.w_pixels;
+		double v_fov = 2.0 * atan(tan(h_fov / 2.0) * aspect);
+
+		parts->distortion.fov[eye].angle_left = (float)(-h_fov / 2.0);
+		parts->distortion.fov[eye].angle_right = (float)(h_fov / 2.0);
+		parts->distortion.fov[eye].angle_up = (float)(v_fov / 2.0);
+		parts->distortion.fov[eye].angle_down = (float)(-v_fov / 2.0);
+	}
+}
+
+
+/*
+ *
+ * Device functions.
+ *
+ */
+
+static void
+optiforge_hmd_destroy(struct xrt_device *xdev)
+{
+	struct optiforge_hmd *hmd = optiforge_hmd(xdev);
+
+	// Remove the variable tracking.
+	u_var_remove_root(hmd);
+
+	u_device_free(&hmd->base);
+}
+
+static xrt_result_t
+optiforge_hmd_get_tracked_pose(struct xrt_device *xdev,
+                               enum xrt_input_name name,
+                               int64_t at_timestamp_ns,
+                               struct xrt_space_relation *out_relation)
+{
+	struct optiforge_hmd *hmd = optiforge_hmd(xdev);
+
+	if (name != XRT_INPUT_GENERIC_HEAD_POSE) {
+		U_LOG_XDEV_UNSUPPORTED_INPUT(&hmd->base, hmd->log_level, name);
+		return XRT_ERROR_INPUT_UNSUPPORTED;
+	}
+
+	// The survive driver leaves this untouched until libsurvive has created the tracker.
+	struct xrt_space_relation tracker_relation = XRT_SPACE_RELATION_ZERO;
+	xrt_result_t xret = xrt_device_get_tracked_pose( //
+	    hmd->tracker,                                //
+	    XRT_INPUT_GENERIC_TRACKER_POSE,              //
+	    at_timestamp_ns,                             //
+	    &tracker_relation);                          //
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+
+	// No pose at all yet, the orientation would be a zero quaternion.
+	if ((tracker_relation.relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT) == 0) {
+		*out_relation = (struct xrt_space_relation)XRT_SPACE_RELATION_ZERO;
+		return XRT_SUCCESS;
+	}
+
+	// Head rotation = tracker rotation * head-relative-to-tracker rotation, then the inverted axes.
+	struct xrt_quat offset_rotation;
+	get_offset_rotation(hmd, &offset_rotation);
+
+	struct xrt_quat head_rotation;
+	math_quat_rotate(&tracker_relation.pose.orientation, &offset_rotation, &head_rotation);
+	invert_axes(hmd, &head_rotation);
+
+	// Centre between the eyes, from the sensor, in the head's axes (+X right, +Y up, -Z forward): back, to the
+	// wearer's left and down by the sensor corrections. Uses the final head rotation so it matches what is shown.
+	struct xrt_vec3 sensor_to_head = {
+	    -hmd->center_cm / 100.0f,
+	    -hmd->height_cm / 100.0f,
+	    hmd->forward_cm / 100.0f,
+	};
+	struct xrt_vec3 sensor_to_head_world;
+	math_quat_rotate_vec3(&head_rotation, &sensor_to_head, &sensor_to_head_world);
+
+	*out_relation = (struct xrt_space_relation)XRT_SPACE_RELATION_ZERO;
+	out_relation->pose.orientation = head_rotation;
+	out_relation->pose.position = m_vec3_add(tracker_relation.pose.position, sensor_to_head_world);
+
+	// Velocities would be wrong after the correction and inversion, nothing needs them for the head.
+	out_relation->relation_flags = (enum xrt_space_relation_flags)(
+	    tracker_relation.relation_flags &
+	    ~(XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT | XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT));
+
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+optiforge_hmd_get_view_poses(struct xrt_device *xdev,
+                             const struct xrt_vec3 *default_eye_relation,
+                             int64_t at_timestamp_ns,
+                             enum xrt_view_type view_type,
+                             uint32_t view_count,
+                             struct xrt_space_relation *out_head_relation,
+                             struct xrt_fov *out_fovs,
+                             struct xrt_pose *out_poses)
+{
+	return u_device_get_view_poses( //
+	    xdev,                       //
+	    default_eye_relation,       //
+	    at_timestamp_ns,            //
+	    view_type,                  //
+	    view_count,                 //
+	    out_head_relation,          //
+	    out_fovs,                   //
+	    out_poses);                 //
+}
+
+static xrt_result_t
+optiforge_hmd_get_visibility_mask(struct xrt_device *xdev,
+                                  enum xrt_visibility_mask_type type,
+                                  uint32_t view_index,
+                                  struct xrt_visibility_mask **out_mask)
+{
+	struct xrt_fov fov = xdev->hmd->distortion.fov[view_index];
+	u_visibility_mask_get_default(type, &fov, out_mask);
+	return XRT_SUCCESS;
+}
+
+
+/*
+ *
+ * 'Exported' functions.
+ *
+ */
+
+bool
+optiforge_hmd_enabled(void)
+{
+	return debug_get_bool_option_optiforge_hmd();
+}
+
+struct xrt_device *
+optiforge_hmd_create(struct xrt_device **xdevs, size_t xdev_count)
+{
+	enum u_logging_level log_level = debug_get_log_option_optiforge_log();
+	const char *serial = debug_get_option_optiforge_tracker_serial();
+
+	struct xrt_device *tracker = find_tracker(xdevs, xdev_count, serial);
+	if (tracker == NULL) {
+		U_LOG_IFL_E(log_level, "Optiforge HMD: tracker '%s' not found, is it on and seen by the base stations?",
+		            (serial != NULL && serial[0] != '\0') ? serial : "(any generic tracker)");
+		return NULL;
+	}
+
+	// No U_DEVICE_ALLOC_TRACKING_NONE: we use the tracker's tracking origin.
+	enum u_device_alloc_flags flags = U_DEVICE_ALLOC_HMD;
+	struct optiforge_hmd *hmd = U_DEVICE_ALLOCATE(struct optiforge_hmd, flags, 1, 0);
+
+	u_device_populate_function_pointers(&hmd->base, optiforge_hmd_get_tracked_pose, optiforge_hmd_destroy);
+	hmd->base.get_view_poses = optiforge_hmd_get_view_poses;
+	hmd->base.get_visibility_mask = optiforge_hmd_get_visibility_mask;
+
+	hmd->log_level = log_level;
+	hmd->tracker = tracker;
+	hmd->base.tracking_origin = tracker->tracking_origin;
+
+	hmd->yaw_deg = debug_get_float_option_optiforge_yaw();
+	hmd->pitch_deg = debug_get_float_option_optiforge_pitch();
+	hmd->roll_deg = debug_get_float_option_optiforge_roll();
+	hmd->forward_cm = debug_get_float_option_optiforge_forward_correction();
+	hmd->center_cm = debug_get_float_option_optiforge_center_correction();
+	hmd->height_cm = debug_get_float_option_optiforge_height_correction();
+	hmd->invert_yaw = debug_get_bool_option_optiforge_invert_yaw();
+	hmd->invert_pitch = debug_get_bool_option_optiforge_invert_pitch();
+	hmd->invert_roll = debug_get_bool_option_optiforge_invert_roll();
+
+	// This list should be ordered, most preferred first.
+	size_t idx = 0;
+	hmd->base.hmd->blend_modes[idx++] = XRT_BLEND_MODE_OPAQUE;
+	hmd->base.hmd->blend_mode_count = idx;
+
+	snprintf(hmd->base.str, XRT_DEVICE_NAME_LEN, "Optiforge HMD");
+	snprintf(hmd->base.serial, XRT_DEVICE_NAME_LEN, "Optiforge HMD");
+
+	// Setup input.
+	hmd->base.name = XRT_DEVICE_GENERIC_HMD;
+	hmd->base.device_type = XRT_DEVICE_TYPE_HMD;
+	hmd->base.inputs[0].name = XRT_INPUT_GENERIC_HEAD_POSE;
+	hmd->base.supported.orientation_tracking = tracker->supported.orientation_tracking;
+	hmd->base.supported.position_tracking = tracker->supported.position_tracking;
+
+	// Display.
+	float refresh_hz = debug_get_float_option_optiforge_refresh_hz();
+	hmd->base.hmd->screens[0].nominal_frame_interval_ns = time_s_to_ns(1.0f / refresh_hz);
+
+	enum optiforge_panel_rotation rotation = get_panel_rotation();
+	bool swap_eyes = debug_get_bool_option_optiforge_swap_eyes();
+	setup_views(hmd, rotation, swap_eyes);
+
+	// No lenses modelled yet, fills in xdev->compute_distortion().
+	u_distortion_mesh_set_none(&hmd->base);
+
+	OF_INFO(hmd, "Using tracker '%s' (%s)", tracker->serial, tracker->str);
+	OF_INFO(hmd, "Tracker rotation (yaw pitch roll): %f %f %f", hmd->yaw_deg, hmd->pitch_deg, hmd->roll_deg);
+	OF_INFO(hmd, "Sensor correction (cm): forward %f, center %f, height %f; invert yaw/pitch/roll: %d %d %d",
+	        hmd->forward_cm, hmd->center_cm, hmd->height_cm, hmd->invert_yaw, hmd->invert_pitch, hmd->invert_roll);
+	OF_INFO(hmd, "Panel %dx%d @ %.2f Hz, rotation %s, eyes %s, FOV %.1f deg", PANEL_W_PIXELS, PANEL_H_PIXELS,
+	        refresh_hz, debug_get_option_optiforge_panel_rotation(), swap_eyes ? "swapped" : "normal",
+	        debug_get_float_option_optiforge_fov());
+
+	// Setup variable tracker, the rotation, corrections and inversion can be tuned live in the debug GUI.
+	u_var_add_root(hmd, "Optiforge HMD", true);
+	u_var_add_log_level(hmd, &hmd->log_level, "log_level");
+	u_var_add_f32(hmd, &hmd->yaw_deg, "Tracker yaw (deg)");
+	u_var_add_f32(hmd, &hmd->pitch_deg, "Tracker pitch (deg)");
+	u_var_add_f32(hmd, &hmd->roll_deg, "Tracker roll (deg)");
+	u_var_add_f32(hmd, &hmd->forward_cm, "Forward correction (cm)");
+	u_var_add_f32(hmd, &hmd->center_cm, "Center correction (cm)");
+	u_var_add_f32(hmd, &hmd->height_cm, "Height correction (cm)");
+	u_var_add_bool(hmd, &hmd->invert_yaw, "Invert yaw");
+	u_var_add_bool(hmd, &hmd->invert_pitch, "Invert pitch");
+	u_var_add_bool(hmd, &hmd->invert_roll, "Invert roll");
+
+	return &hmd->base;
+}
